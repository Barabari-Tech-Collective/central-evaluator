# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- API auth (V-04) ----
# Required header on POST /evaluate:  x-api-key: <API_KEY>
API_KEY=change-me-to-a-long-random-secret

# ---- GitHub webhook auth ----
# Required header on POST /api/webhook/github: x-webhook-secret: <WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-a-long-random-secret

# ---- Redis (BullMQ) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave blank for local Redis without ACL. For managed Redis set both.
REDIS_USERNAME=
REDIS_PASSWORD=

# ---- OpenAI (rubric parsing + GPT-4o vision) ----
OPENAI_API_KEY=

# ---- Groq (backend evaluator AI feedback) ----
GROQ_API_KEY=
GROQ_BASE_URL=

# ---- E2B sandboxes (backend / react / fullstack evaluators) ----
E2B_API_KEY=

# ---- SSRF allowlist (V-03) ----
# Comma-separated git hosts allowed for submission repoUrl.
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# ---- Logging ----
LOG_LEVEL=info
LOG_DIR=./logs
